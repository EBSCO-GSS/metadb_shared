{
  "displayName": "MEC: PLANO DE ENSINO - RECONHECIMENTO - Agrupado por: Biblioteca, Programa de Ensino e Disciplina (Exemplares e Empréstimos) - Sintético",
  "description": "Lista acervos em formato de referência, relacionados aos planos de ensino das unidades organizacionais.",
  "instructions": "Se desejar, selecione um ou mais Filtros no (Campo de seleção) Ou digite no (Campo texto) o(s) valor(es) separados por vírgula (,).",
  "parameters": [
    {
      "name": "p_library_code_1",
      "displayName": "> BIBLIOTECA - Campo de seleção",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.fetchOptions": {
        "wsapiPath": "location-units/libraries",
        "query": "cql.allRecords=1",
        "sortSpec": "name",
        "limit": 2000,
        "resultPath": "loclibs",
        "queryField": "code",
        "displaySpec": "{{name}} ({{code}})"
      }
    },
    {
      "name": "p_library_code_2",
      "displayName": "Campo texto (Ex.: CCTBA,CTOLD,MAINLIB)",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.options": [
        "MCALT",
        "CCTBA",
        "CTOLD",
        "MLBUSLIB",
        "MAINLIB",
        "MLMEDLIB",
        "LAWLIB"
      ],
      "controlled.allowOtherValues": true
    },
    {
      "name": "p_items_material_type_1",
      "displayName": "> TIPO DE MATERIAL - Campo de seleção",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.fetchOptions": {
        "wsapiPath": "material-types",
        "query": "cql.allRecords=1",
        "sortSpec": "name",
        "limit": 1000,
        "resultPath": "mtypes",
        "queryField": "name",
        "displaySpec": "{{name}}"
      }
    },
    {
      "name": "p_items_material_type_2",
      "displayName": "Campo texto (Ex.: Book,Electronic resource,On order)",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.options": [
        "Book",
        "Cartographic Material",
        "Electronic resource",
        "Equipment",
        "Graphic novel",
        "Key",
        "Laptop",
        "Microform",
        "Musical score",
        "On order",
        "Printed music",
        "Serial",
        "Sound recording",
        "Sound recording - Foreign Language",
        "Two-dimensional graphic",
        "Video recording"
      ],
      "controlled.allowOtherValues": true
    },
    {
      "name": "p_instance_status_1",
      "displayName": "> SITUAÇÃO DO ACERVO - Campo de seleção",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.fetchOptions": {
        "wsapiPath": "instance-statuses",
        "query": "cql.allRecords=1",
        "sortSpec": "name",
        "limit": 2000,
        "resultPath": "instanceStatuses",
        "queryField": "code",
        "displaySpec": "{{name}} ({{code}})"
      }
    },
    {
      "name": "p_instance_status_2",
      "displayName": "Campo texto (Ex.: batch,fast,order)",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.options": [
        "batch",
        "cat",
        "col",
        "fast",
        "kdelete",
        "delete",
        "none",
        "order",
        "other",
        "template",
        "temp",
        "uncat"
      ],
      "controlled.allowOtherValues": true
    },
    {
      "name": "p_items_status_1",
      "displayName": "> SITUAÇÃO DO EXEMPLAR - Campo de seleção",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.options": [
        "",
        "Aged to lost",
        "Available",
        "Awaiting delivery",
        "Awaiting pickup",
        "Checked out",
        "Claimed returned",
        "Declared lost",
        "In process",
        "In process (non-requestable)",
        "Intellectual item",
        "In transit",
        "Lost and paid",
        "Missing",
        "On order",
        "Order closed",
        "Paged",
        "Restricted",
        "Unavailable",
        "Unknown",
        "Withdrawn"
      ],
      "controlled.allowOtherValues": false
    },
    {
      "name": "p_items_status_2",
      "displayName": "Campo texto (Ex.: Available,Checked out,Intellectual item)",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.options": [
        "Aged to lost",
        "Available",
        "Awaiting delivery",
        "Awaiting pickup",
        "Checked out",
        "Claimed returned",
        "Declared lost",
        "In process",
        "In process (non-requestable)",
        "Intellectual item",
        "In transit",
        "Lost and paid",
        "Missing",
        "On order",
        "Order closed",
        "Paged",
        "Restricted",
        "Unavailable",
        "Unknown",
        "Withdrawn"
      ],
      "controlled.allowOtherValues": true
    },
    {
      "name": "p_instances_initial_acquisition_date",
      "displayName": "> DATA INICIAL DE AQUISIÇÃO",
      "required": false,
      "type": "date",
      "default": ""
    },
    {
      "name": "p_instances_final_acquisition_date",
      "displayName": "> DATA FINAL DE AQUISIÇÃO",
      "required": false,
      "type": "date",
      "default": ""
    },
    {
      "name": "p_department_code",
      "displayName": "> UNIDADE ORGANIZACIONAL",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.fetchOptions": {
        "wsapiPath": "coursereserves/departments",
        "query": "description==\"*-*\"",
        "sortSpec": "name",
        "limit": 2000,
        "resultPath": "departments",
        "queryField": "id",
        "displaySpec": "{{description}}"
      }
    },
    {
      "name": "p_course_code",
      "displayName": "> DISCIPLINA",
      "required": false,
      "type": "text",
      "default": "",
      "controlled.fetchOptions": {
        "wsapiPath": "coursereserves/courses",
        "query": "courseNumber==\"G10*\"",
        "sortSpec": "name",
        "limit": 100,
        "resultPath": "courses",
        "queryField": "courseNumber",
        "displaySpec": "{{courseNumber}} - {{name}}"
      }
    },
    {
      "name": "p_year",
      "displayName": "> ANO (Ex.: 2026)",
      "required": false,
      "type": "text",
      "default": ""
    },
    {
      "name": "p_semester",
      "displayName": "> SEMESTRE (Ex.: 1)",
      "required": false,
      "type": "text",
      "default": ""
    },
    {
      "name": "p_period",
      "displayName": "> PERÍODO (Ex.: 1)",
      "required": false,
      "type": "text",
      "default": ""
    }
  ]
}
